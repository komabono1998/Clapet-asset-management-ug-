# ------------------------------------------------------------------
# CLAPET ASSET MANAGEMENT UG - SMC : environment settings
# Copy this file to `.env` in the site root and edit the values.
# `.env` is never committed to Git and is blocked from the web.
# Anything saved in Admin > Contact & credentials overrides the CONTACT_* values below.
# ------------------------------------------------------------------

# --- Application ---------------------------------------------------
APP_ENV=production            # production | local
APP_DEBUG=false               # true only on a local machine (shows PHP errors)
APP_URL=https://clapetassets.com
APP_TIMEZONE=Africa/Kampala

# --- Public contact details (defaults; editable later in the admin) --
CONTACT_PHONE="+256 785 274 288"
CONTACT_EMAIL=Okunamatthew72@gmail.com
CONTACT_WHATSAPP=256751299076
CONTACT_ADDRESS="Kampala, Uganda"
CONTACT_HOURS="Mon – Fri · 8:00 – 17:00 (EAT)"
DIRECTOR_NAME="Okuna Mathew Elvis"

# --- Email notifications for new enquiries --------------------------
NOTIFY_EMAIL=true
MAIL_FROM=no-reply@clapetassets.com   # use a mailbox on your own domain

# --- Forms and uploads ----------------------------------------------
RATE_LIMIT_PER_HOUR=8         # submissions per visitor per hour
MAX_UPLOAD_MB=5

# --- Visitor analytics (cookieless) ---------------------------------
ANALYTICS_ENABLED=true
